[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "audio2text-sidecar"
version = "2.0.0"
description = "Audio2Text sidecar process for Tauri IPC"
requires-python = ">=3.8"
license = {text = "Apache-2.0"}
authors = [
    {name = "CENF", email = "soporte@cenfarg.com.ar"}
]

dependencies = [
    "groq>=0.4.0",
    "sounddevice>=0.4.6",
    "soundfile>=0.12.1",
    "numpy>=1.24.0",
    "pywin32>=306",
    "requests>=2.31.0",
    "psutil>=5.9.0",
    "pyperclip>=1.8.2",
    "pyautogui>=0.9.54",
    "keyboard>=0.13.5",
    "pystray>=0.19.4",
    "Pillow>=10.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
]

[project.scripts]
audio2text-sidecar = "backend.sidecar_entry:main"

[tool.setuptools]
packages = ["backend"]

[tool.setuptools.package-data]
"*" = ["*.json"]

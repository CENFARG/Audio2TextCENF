{
  "$schema": "https://design-tokens.fulib.org/schema/tokens.json",
  "description": "Design tokens del ecosistema amBotHs — Tema Dark Goldenrod",
  "version": "1.0.0",
  "color": {
    "bg": {
      "primary": { "value": "#1a1b1e", "description": "Fondo principal de la aplicación" },
      "secondary": { "value": "#25262b", "description": "Fondo secundario: cards, paneles, dropdowns" },
      "tertiary": { "value": "#2c2e33", "description": "Fondo terciario: hover, active, scrollbar track" },
      "hover": { "value": "#373a40", "description": "Fondo hover sobre elementos interactivos" },
      "overlay": { "value": "rgba(0,0,0,0.6)", "description": "Fondo de overlays y modales" }
    },
    "text": {
      "primary": { "value": "#c1c2c5", "description": "Texto principal de alta legibilidad" },
      "secondary": { "value": "#909296", "description": "Texto secundario: metadata, labels" },
      "muted": { "value": "#5c5f66", "description": "Texto deshabilitado oplaceholder" },
      "inverse": { "value": "#ffffff", "description": "Texto sobre fondos oscuros" }
    },
    "accent": {
      "default": { "value": "#DAA520", "description": "Acento principal: Goldenrod" },
      "hover": { "value": "#e0b830", "description": "Acento hover" },
      "muted": { "value": "rgba(218,165,32,0.15)", "description": "Acento en fondos: backgrounds tenues" },
      "border": { "value": "rgba(218,165,32,0.3)", "description": "Acento en bordes" }
    },
    "border": {
      "default": { "value": "#373a40", "description": "Borde estándar" },
      "strong": { "value": "#4a4d52", "description": "Borde destacado" }
    },
    "status": {
      "success": { "value": "#51cf66", "description": "Verde: éxito/online" },
      "successBg": { "value": "rgba(81,207,102,0.15)", "description": "Fondo de mensaje éxito" },
      "warning": { "value": "#fcc419", "description": "Amarillo: advertencia" },
      "danger": { "value": "#ff6b6b", "description": "Rojo: error/peligro" },
      "dangerBg": { "value": "rgba(255,107,107,0.15)", "description": "Fondo de mensaje error" }
    },
    "code": {
      "bg": { "value": "#1e1f22", "description": "Fondo de bloques de código" },
      "text": { "value": "#e6e6e6", "description": "Texto en bloques de código" }
    }
  },
  "spacing": {
    "xxs": { "value": "2px", "description": "Mínimo espacio" },
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "12px", "description": "Espaciado estándar entre elementos" },
    "lg": { "value": "16px" },
    "xl": { "value": "24px", "description": "Espaciado grande entre secciones" },
    "xxl": { "value": "32px" }
  },
  "radius": {
    "sm": { "value": "4px", "description": "Border-radius pequeño: badges, chips" },
    "md": { "value": "8px", "description": "Border-radius medio: cards, inputs" },
    "lg": { "value": "12px", "description": "Border-radius grande: modales" },
    "full": { "value": "9999px", "description": "Border-radius circular" }
  },
  "font": {
    "family": { "value": "system-ui, -apple-system, sans-serif", "description": "Fuente principal del sistema" },
    "familyMono": { "value": "'Cascadia Code', 'Fira Code', 'Consolas', monospace", "description": "Fuente monoespaciada para código" },
    "size": {
      "xs": { "value": "11px", "description": "Texto mínimo: badges, timestamps" },
      "sm": { "value": "12px", "description": "Texto pequeño: metadata" },
      "base": { "value": "14px", "description": "Texto base de la aplicación" },
      "lg": { "value": "16px", "description": "Texto grande: títulos" },
      "xl": { "value": "20px", "description": "Título de sección" },
      "xxl": { "value": "24px", "description": "Título principal" }
    },
    "weight": {
      "normal": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "normal": { "value": "1.5" },
      "relaxed": { "value": "1.75" }
    }
  },
  "shadow": {
    "sm": { "value": "0 1px 3px rgba(0,0,0,0.3)", "description": "Sombra pequeña: cards en reposo" },
    "md": { "value": "0 4px 6px rgba(0,0,0,0.4)", "description": "Sombra media: dropdowns, modales" },
    "lg": { "value": "0 8px 24px rgba(0,0,0,0.5)", "description": "Sombra grande: overlays, tooltips" }
  },
  "transition": {
    "fast": { "value": "0.15s ease", "description": "Transición rápida: hovers" },
    "normal": { "value": "0.25s ease", "description": "Transición estándar" },
    "slow": { "value": "0.35s ease", "description": "Transición lenta: modales" }
  },
  "zIndex": {
    "base": { "value": "1", "description": "Capa base" },
    "dropdown": { "value": "100", "description": "Menús desplegables" },
    "sticky": { "value": "200", "description": "Elementos sticky" },
    "modal": { "value": "300", "description": "Modales y overlays" },
    "tooltip": { "value": "400", "description": "Tooltips" }
  },
  "size": {
    "sidebar": {
      "width": { "value": "420px", "description": "Ancho del panel lateral" },
      "height": { "value": "900px", "description": "Alto del panel lateral" }
    },
    "icon": {
      "sm": { "value": "14px" },
      "md": { "value": "18px" }
    },
    "scrollbar": {
      "width": { "value": "6px" }
    }
  }
}

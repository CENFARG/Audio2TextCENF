[flake8]
# Flake8 configuration for Audio2Text
# Max line length (matches black default)
max-line-length = 120

# Exclude directories
exclude =
    .git,
    .venv,
    venv,
    build,
    dist,
    _old_versions_archive,
    .context,
    .engram,
    .memories,
    .lessons,
    .gestion,
    .atl

# Ignore specific errors for compatibility
# E203: Whitespace before ':' (conflicts with black)
# W503: Line break before binary operator (conflicts with black)
# E501: Line too long (handled by black)
ignore = E203, W503, E501

# Per-file ignores
# F401: Unused imports (common in test files and __init__.py)
per-file-ignores =
    __init__.py:F401
    test_*.py:F401

# Max complexity (McCabe complexity)
max-complexity = 20

# Show source code for each error
show-source = true

# Show relevant text for each error
show-pep8 = true

# Count number of occurrences of each error/warning
count = true

# Statistics
statistics = true

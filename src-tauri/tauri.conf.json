{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-docs/refs/heads/main/tauri.schema.json",
  "productName": "Audio2Text",
  "version": "0.17.0",
  "identifier": "com.cenf.audio2text",
  "build": {
    "beforeDevCommand": "npm --prefix src run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix src run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio2Text",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": ["icons/icon.png"]
  }
}